HitboxToggle.MouseButton1Click:Connect(function()
    hitboxActive = not hitboxActive
    HitboxToggle.Text = hitboxActive and "📦 เปิดใช้งานขยาย Hitbox: เปิด (ON)" or "📦 เปิดใช้งานขยาย Hitbox: ปิด (OFF)"
