local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 2
fovCircle.Filled = false
fovCircle.Visible = true

local function isVisible(targetPart)
    if not wallcheckActive then return true end
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit * (targetPart.Position - origin).Magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    
    local result = workspace:Raycast(origin, direction, raycastParams)
    return not result or result.Instance:IsDescendantOf(targetPart.Parent)
end

RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    fovCircle.Radius = presetFov
    fovCircle.Position = screenCenter
    
    local hue = (tick() % 5) / 5
    fovCircle.Color = Color3.fromHSV(hue, 1, 1)
    fovCircle.Visible = strongAimActive
    
    if strongAimActive then
        local closestTarget = nil
        local shortestDist = presetFov
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild(targetPartName) then
                if not teamcheckActive or (teamcheckActive and plr.Team ~= LocalPlayer.Team) then
                    local part = plr.Character[targetPartName]
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(part.Position)
                    
                    if onScreen then
                        local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
                        local distFromCenter = (screenCenter - screenPos).Magnitude
                        
                        if distFromCenter < shortestDist and isVisible(part) then
                            shortestDist = distFromCenter
                            closestTarget = part
                        end
                    end
                end
            end
        end
        
        if npcLockActive then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild(targetPartName) then
                    local isPlayerModel = Players:GetPlayerFromCharacter(obj)
                    if not isPlayerModel and obj ~= LocalPlayer.Character then
                        local part = obj[targetPartName]
                        local screenPoint, onScreen = Camera:WorldToViewportPoint(part.Position)
                        
                        if onScreen then
                            local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
                            local distFromCenter = (screenCenter - screenPos).Magnitude
                            
                            if distFromCenter < shortestDist and isVisible(part) then
                                shortestDist = distFromCenter
                                closestTarget = part
                            end
                        end
                    end
                end
            end
        end
        
        if closestTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
        end
    end
end)
